# Turso / libSQL
TURSO_DATABASE_URL=libsql://relayroom-your-org.turso.io
TURSO_AUTH_TOKEN=

# 32 random bytes, base64. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:4310

# Payments (phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=

# AI agents — any one key enables model-written drafts; otherwise the
# deterministic local parser is used and the UI says so.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
